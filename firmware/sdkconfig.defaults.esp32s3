# ESP32-S3 target-specific defaults. Auto-applied by ESP-IDF when
# `idf.py set-target esp32s3` is the active target. Overrides the
# 4 MB / no-PSRAM defaults baked into `sdkconfig.defaults` for the
# Waveshare ESP32-S3-Touch-AMOLED-1.43 board.
#
# Switch profiles via menuconfig after running set-target:
#   idf.py set-target esp32s3
#   idf.py menuconfig  → BurnScope display → Waveshare AMOLED-1.43

# Waveshare AMOLED-1.43 ships a 16 MB Winbond flash + 8 MB Octal PSRAM.
# We use the full 16 MB: 5 MB per OTA slot (3.3× current app, leaves
# room to grow without another flash-size migration) plus a ~5.8 MB
# LittleFS storage volume for the pixel-aging map and future assets.
# NVS / otadata / phy_init offsets are unchanged from partitions-8mb.csv
# so the TOFU pairing slot survives the layout migration without a
# `erase-flash`.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-16mb.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions-16mb.csv"

# Bootloader-driven rollback so a failed OTA can't brick the device.
# Pairs with `esp_ota_mark_app_valid_cancel_rollback()` called from
# the firmware after its first healthy /summary push — anything that
# boots but never proves itself is reverted on the next reboot.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Enable PSRAM (Octal SPI). The AMOLED profile uses a stripe-buffered
# LVGL pipeline so PSRAM is not strictly required for the framebuffer,
# but having it available gives headroom for richer assets and lets
# us experiment with full-screen double buffering if needed.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Default to the AMOLED profile when the target is esp32s3. Override
# in menuconfig if you have a different ESP32-S3 display board.
CONFIG_BURNSCOPE_DISPLAY_CYD2USB_ST7789=
CONFIG_BURNSCOPE_DISPLAY_AMOLED_SH8601=y

# AMOLED ui.c renders the agent dial with a richer type ramp than CYD:
# M48 for the primary % (display-size), M36 for the secondary %,
# M14 for the footer + per-row countdowns. CYD keeps M10/M16/M24/M28.
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_48=y
